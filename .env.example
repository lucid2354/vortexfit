# --- Django ---
DJANGO_SECRET_KEY=поменяй-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=vortexfit.uz,www.vortexfit.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://vortexfit.uz,https://www.vortexfit.uz
ADMIN_URL=panel-x7k2/

# --- Домен для Caddy (HTTPS выпускается автоматически) ---
DOMAIN=vortexfit.uz

# --- PostgreSQL ---
POSTGRES_DB=vortexfit
POSTGRES_USER=vortexfit
POSTGRES_PASSWORD=поменяй-пароль
POSTGRES_HOST=db

# --- Telegram ---
# Токен бота из @BotFather, chat id чата/группы менеджера (см. README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Юзернейм менеджера для кнопки «Заказать в Telegram» (без @)
TELEGRAM_MANAGER=your_manager
